# Secrets for docker compose (DO NOT COMMIT real values)
#
# Copy this file to `.cont_one_app.secrets.env` and fill real secrets locally.
# The `.cont_one_app.secrets.env` file is ignored by git via `.gitignore`.
#
# Optional Bearer token for mcp_peresvet → one_app (enterprise authorization):
# PERESVET_BEARER_TOKEN=

# Grafana MCP (docker-compose.mcp.grafana.yml). Leave empty unless --mcp-grafana true.
# How to create the token: Administration → Users and access → Service accounts →
# Add service account token.
# https://grafana.com/docs/grafana/latest/administration/service-accounts/
# GRAFANA_SERVICE_ACCOUNT_TOKEN=
