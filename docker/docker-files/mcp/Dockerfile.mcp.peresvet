FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /usr/src/peresvet-mcp

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        python3-pip \
        ca-certificates \
    && python3 -m venv /opt/venv \
    && rm -rf /var/lib/apt/lists/*

# В локальном режиме используем предустановленные Python-пакеты
# LOCAL_MODE может быть задан через ARG или через файл .local-mode
ARG LOCAL_MODE="false"
COPY .local-mode* ./
RUN if [ -f .local-mode ]; then \
        . ./.local-mode 2>/dev/null || true; \
        LOCAL_MODE="${LOCAL_MODE:-false}"; \
    fi && \
    if [ "${LOCAL_MODE}" = "true" ]; then \
        echo "Локальный режим активирован: будут использоваться предустановленные Python-пакеты"; \
    fi

# В локальном режиме используем предустановленные Python-пакеты
RUN if [ "${LOCAL_MODE}" = "true" ] && [ -d /preinstalled/python-site-packages ]; then \
        cp -Rp /preinstalled/python-site-packages/* /opt/venv/lib/python3.14/site-packages/ 2>/dev/null || true && \
        echo "Используются предустановленные Python-пакеты"; \
    else \
        pip install --no-cache-dir fastmcp aiohttp; \
    fi

COPY src/mcp_server /usr/src/peresvet-mcp/mcp_server

CMD ["python", "-m", "mcp_server.server"]
