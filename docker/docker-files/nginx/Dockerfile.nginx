FROM nginx:1.25.3-alpine-slim

# this is actual only for minimal version of parent image
RUN adduser -u 1000 -D -S -G www-data www-data

RUN mkdir -p /var/www/docs/pdf
COPY docs/pdf/*.pdf /var/www/docs/pdf/
RUN chown -R www-data:www-data /var/www
COPY config/nginx/nginx.conf /etc/nginx/
# openssl stays in the image: the entrypoint issues the self-signed certificate
# for NGINX_TLS_IP when the container starts.
RUN apk add --no-cache openssl \
    && mkdir -p /etc/nginx/ssl
COPY docker/docker-files/nginx/20-self-signed-cert.sh /docker-entrypoint.d/20-self-signed-cert.sh
RUN chmod 755 /docker-entrypoint.d/20-self-signed-cert.sh
COPY config/nginx/no_ssl/default.conf.no_ssl.template /etc/nginx/templates/default.conf.template
#COPY config/nginx/ssl/default.conf.ssl.template /etc/nginx/templates/
COPY config/nginx/peresvet /etc/nginx/templates/

#WORKDIR /etc/nginx/conf.d
#RUN rm default.conf
#RUN ln -s ./default.conf.no_ssl ./default.conf
