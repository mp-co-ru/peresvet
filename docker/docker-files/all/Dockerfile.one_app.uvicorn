FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LDAP_ORGANISATION=mycompany
ENV LDAP_DOMAIN=mycompany.com
ENV LDAP_ADMIN_PASSWORD=123456
ENV PIP_NO_INDEX=1
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# В локальном режиме используем предустановленные пакеты
# LOCAL_MODE может быть задан через ARG или через файл .local-mode
ARG LOCAL_MODE="false"
COPY .local-mode* ./
RUN if [ -f .local-mode ]; then \
        . ./.local-mode 2>/dev/null || true; \
        LOCAL_MODE="${LOCAL_MODE:-false}"; \
    fi && \
    if [ "${LOCAL_MODE}" = "true" ]; then \
        echo "Локальный режим активирован: будут использоваться предустановленные зависимости"; \
    else \
        echo "Локальный режим отключён: зависимости будут установлены при сборке"; \
    fi

# Системный Python 3.14 (пакет python3 в Ubuntu 26.04) и библиотеки,
# с которыми собран python-ldap.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        python3-pip \
        ca-certificates \
        libldap2 \
        libsasl2-2 \
        libsasl2-modules \
        ffmpeg \
    && python3 -m venv /opt/venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src
RUN mkdir mpc-peresvet
COPY requirements.txt /usr/src/mpc-peresvet/
COPY packages/ /usr/src/mpc-peresvet/packages/
WORKDIR /usr/src/mpc-peresvet

# В локальном режиме копируем подготовленные зависимости в Docker-образ
RUN if [ "${LOCAL_MODE}" = "true" ]; then \
        mkdir -p /preinstalled/apt-cache /preinstalled/python-site-packages 2>/dev/null || true; \
    fi

# В локальном режиме используем предустановленные Python-пакеты
RUN if [ "${LOCAL_MODE}" = "true" ] && [ -d /preinstalled/python-site-packages ]; then \
        cp -Rp /preinstalled/python-site-packages/* /opt/venv/lib/python3.14/site-packages/ 2>/dev/null || true && \
        apt-get clean && rm -rf /var/lib/apt/lists/*; \
    else \
        pip install --no-cache-dir --no-index -r requirements.txt; \
    fi

RUN mkdir /usr/src/mpc-peresvet/log

COPY src /usr/src/mpc-peresvet/src
COPY methods/packages /usr/src/mpc-peresvet/methods/packages
RUN rm -rf /usr/src/mpc-peresvet/src/__pycache__

# set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /usr/src/mpc-peresvet

CMD ["python", "src/services/one_app/one_app.py"]
