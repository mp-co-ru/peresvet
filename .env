# Defaults for ./run_one_app.sh
# CLI options override these values.

# Registry mirror URL with scheme (http:// or https://). Empty = Docker Hub.
# Public mirror for clients:
PRS_REGISTRY_MIRROR=https://mpcperesvet.matchpoint-consulting.ru/dist/images

# Server name for nginx (empty = current host name).
PRS_HOSTNAME=

# IPv4 address of this server for the self-signed HTTPS certificate.
# Empty: ./run_one_app.sh warns and stops, unless --ssl true.
# CLI --ip overrides this value.
PRS_IP=

# false (default): HTTPS with a self-signed certificate for PRS_IP.
# true: HTTPS with prepared certificates from certificates/tls/servers/<hostname>/.
PRS_SSL=false

# Rebuild application images before start: true or false.
PRS_BUILD=false

# Local mode: pre-install dependencies in distribution (for offline/limited internet).
# Set to true when running from a locally-prepared distribution.
LOCAL_MODE=false

# Skip pre-flight pull of required base images: 1 or 0.
PRS_SKIP_IMAGE_PULL=0
